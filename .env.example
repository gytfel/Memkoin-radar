# Скопируй в .env и подставь свои значения:
#     cp .env.example .env
#
# Скрипты сами читают .env рядом с config.yaml — экспортировать вручную
# не нужно. Если переменная уже задана в окружении, она приоритетнее файла.
#
# .env в git не коммитить: это секреты. Утёкший токен бота отзывается
# у @BotFather командой /revoke.

# helius.dev — бесплатного тарифа хватает для старта
HELIUS_API_KEY=

# токен бота у @BotFather
TELEGRAM_BOT_TOKEN=

# свой chat_id узнать у @userinfobot (для групп начинается с -100)
TELEGRAM_CHAT_ID=
